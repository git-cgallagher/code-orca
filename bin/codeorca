#!/usr/bin/env bash
# codeorca: run code-orca from the code-orca-runtime image, in the current directory.
#   bin/codeorca validate -p codeorca.yaml
#   aws-vault exec <profile> -- bin/codeorca run plan-only -p codeorca.yaml
#   CODEORCA_IMAGE=ghcr.io/git-cgallagher/code-orca-runtime:main bin/codeorca doctor
#
# This wrapper never runs aws-vault (or any other credential helper) itself: the caller wraps it, so the
# credentials exist only in that one process tree, e.g. `aws-vault exec <profile> -- bin/codeorca run ...`.
# It never starts, stops or restarts Docker (Docker Desktop is shared with other workloads).
#
# What the container gets, and nothing else:
#   mounts   $PWD -> /work (also the working directory)
#            ~/.ssh/known_hosts -> /root/.ssh/known_hosts, read-only (when the file exists)
#            the ssh agent -> /ssh-agent (macOS: Docker Desktop's /run/host-services/ssh-auth.sock;
#              Linux: $SSH_AUTH_SOCK, when it is a socket)
#            ~/.terraform.d/plugin-cache -> /root/.terraform.d/plugin-cache (created if absent)
#            /var/run/docker.sock, ONLY when CODEORCA_DOCKER_SOCKET=1 (host-root-equivalent; Molecule and
#              community.docker need it, nothing else does)
#   env, by NAME only (docker copies each value from this shell; no value is ever on the argv, which
#   `ps` and `docker inspect` show, and there is never an --env-file):
#            AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_CREDENTIAL_EXPIRATION
#            AWS_REGION AWS_DEFAULT_REGION AWS_PROFILE (each only when set)
#            every CODEORCA_* (CODEORCA_REDACTION_KEY included) except CODEORCA_IMAGE and
#            CODEORCA_DOCKER_SOCKET, which configure this wrapper; every TF_VAR_*
#   env, by value (none secret): SSH_AUTH_SOCK=/ssh-agent, TF_PLUGIN_CACHE_DIR=/root/.terraform.d/plugin-cache
#   -it      only when stdin AND stdout are terminals: a human at a terminal can answer a gate or
#            `resume --approve`; an agent or pipe gets no TTY, so the gate refuses (the approval invariant)
#
# The image runs as root, so on Linux the files it writes under $PWD are root-owned. After the run, a
# second container chowns the project's state dir (e.g. .codeorca/) and specs dir back to the caller's
# uid:gid; nothing else in the tree is touched. (On Docker Desktop for macOS the files already show as
# the caller's, so the chown changes nothing.) The exit code is codeorca's, whatever the chown does.
set -euo pipefail

image=${CODEORCA_IMAGE:-ghcr.io/git-cgallagher/code-orca-runtime:latest}

args=(--rm -v "$PWD":/work -w /work)
if [ -t 0 ] && [ -t 1 ]; then args+=(-it); fi

for name in AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_CREDENTIAL_EXPIRATION \
            AWS_REGION AWS_DEFAULT_REGION AWS_PROFILE; do
  if [ -n "${!name+x}" ]; then args+=(-e "$name"); fi
done
# compgen -e lists exported variable NAMES only (no values to parse, so a multi-line value can't
# smuggle in a fake name).
while IFS= read -r name; do
  case $name in
    CODEORCA_IMAGE|CODEORCA_DOCKER_SOCKET) ;;
    CODEORCA_*|TF_VAR_*) args+=(-e "$name") ;;
  esac
done < <(compgen -e)

if [ "$(uname -s)" = Darwin ]; then
  args+=(-v /run/host-services/ssh-auth.sock:/ssh-agent -e SSH_AUTH_SOCK=/ssh-agent)
elif [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "$SSH_AUTH_SOCK" ]; then
  args+=(-v "$SSH_AUTH_SOCK":/ssh-agent -e SSH_AUTH_SOCK=/ssh-agent)
fi
if [ -f "$HOME/.ssh/known_hosts" ]; then
  args+=(-v "$HOME/.ssh/known_hosts":/root/.ssh/known_hosts:ro)
fi

mkdir -p "$HOME/.terraform.d/plugin-cache"
args+=(-v "$HOME/.terraform.d/plugin-cache":/root/.terraform.d/plugin-cache
       -e TF_PLUGIN_CACHE_DIR=/root/.terraform.d/plugin-cache)

if [ "${CODEORCA_DOCKER_SOCKET:-}" = 1 ]; then
  args+=(-v /var/run/docker.sock:/var/run/docker.sock)
fi

set +e
docker run "${args[@]}" "$image" codeorca "$@"
rc=$?
set -e

# --- chown what the root container wrote, back to the caller --------------------------------------
[ "$(id -u)" = 0 ] && exit "$rc"

# The project file, as codeorca's own -p/--project parses it (default ./codeorca.yaml).
project=codeorca.yaml
prev=
for a in "$@"; do
  case $prev in -p|--project) project=$a ;; esac
  case $a in
    --project=*) project=${a#--project=} ;;
    -p?*) project=${a#-p} ;;
  esac
  prev=$a
done

# A relative path with no '..' component, i.e. one that stays under $PWD (the only tree mounted).
inside() {
  case /$1/ in */../*) return 1 ;; esac
  case $1 in /*|'') return 1 ;; esac
  return 0
}
# `key: value  # comment` -> value, quotes stripped; empty when the key is absent.
yaml_scalar() {
  sed -n "s/^$1:[[:space:]]*//p" "$2" | head -n1 | sed -e 's/[[:space:]]#.*$//' -e 's/[[:space:]]*$//' \
    -e "s/^[\"']//" -e "s/[\"']\$//"
}

case $project in "$PWD"/*) project=${project#"$PWD"/} ;; esac
if ! inside "$project" || [ ! -f "$project" ]; then exit "$rc"; fi
root=$(dirname "$project")

state_dir=$(yaml_scalar state_dir "$project"); state_dir=${state_dir:-.codeorca/runs}
specs_dir=$(yaml_scalar specs_dir "$project"); specs_dir=${specs_dir:-specs}

targets=()
for d in "${state_dir%%/*}" "$specs_dir"; do
  p=$root/$d
  p=${p#./}
  # a symlinked dir is skipped: chown would follow it to wherever it points
  if inside "$d" && inside "$p" && [ -e "$p" ] && [ ! -L "$p" ]; then targets+=("$p"); fi
done
[ "${#targets[@]}" -eq 0 ] && exit "$rc"

if ! docker run --rm -v "$PWD":/work -w /work --entrypoint chown "$image" \
    -hR "$(id -u):$(id -g)" -- "${targets[@]}"; then
  echo "codeorca wrapper: could not chown ${targets[*]} back to $(id -u):$(id -g)" >&2
fi
exit "$rc"
